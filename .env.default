# Copy this file to .env and fill in real values for local dev.
# .env is gitignored; .env.default is the committed template.

# Slack signing secret — used to verify incoming webhook requests from Slack.
# Found at: api.slack.com/apps -> your app -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=

# xoxp- user token. All Slack API calls go out as the real user
# (conversations.mark only works with a user token). Get it after installing
# the app to your workspace with the user scopes listed in README.md.
SLACK_USER_TOKEN=

# Comma-separated list of member IDs whose messages should be auto-read
# in channels. Find each via Slack profile -> "..." -> Copy member ID.
# Each ID looks like U01ABC12345. Example: U01ABC12345,U02DEF67890
TARGET_SLACK_USER_IDS=

# Production hostname for Slack's Request URL, e.g. myapp.fly.io
PHX_HOST=

# Phoenix secret key base. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Host-side port that docker-compose binds to (what the reverse proxy
# points at). The container always listens on 4000 internally.
PORT=4000
